// JARVIS — Prisma schema
// SQLite local store for: users, sessions, habits, schedules, briefings,
// email accounts/messages, calendar events, news cache, audit logs,
// settings (encrypted), screenshots log, voice usage stats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         String   @default("user") // user | admin
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]
  habits   Habit[]
  schedules Schedule[]
  briefings Briefing[]
  settings Setting[]
  auditLogs AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Habit {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  cadence     String   @default("daily") // daily | weekly | weekdays | custom
  time        String?  // HH:MM
  streak      Int      @default(0)
  completed   Boolean  @default(false)
  lastDoneAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Schedule {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String?
  cron      String?  // natural cron expression
  at        DateTime? // one-shot time
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Briefing {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  summary   String
  todos     String   // JSON array of strings
  weather   String?
  news      String?  // JSON array of headlines
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailAccount {
  id        String   @id @default(cuid())
  userId    String
  provider  String   // gmail | outlook | imap
  address   String
  // Encrypted OAuth tokens / app passwords (stored encrypted at rest)
  tokenEnc  String
  refreshTokenEnc String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages EmailMessage[]

  @@index([userId])
}

model EmailMessage {
  id        String   @id @default(cuid())
  accountId String
  messageId String
  from      String
  to        String
  subject   String
  preview   String
  body      String?
  read      Boolean  @default(false)
  starred   Boolean  @default(false)
  date      DateTime
  createdAt DateTime @default(now())

  account EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([date])
}

model CalendarEvent {
  id        String   @id @default(cuid())
  userId    String?
  source    String   @default("local") // local | google
  title     String
  description String?
  location  String?
  startAt   DateTime
  endAt     DateTime?
  attendees String?  // JSON array
  createdAt DateTime @default(now())

  @@index([startAt])
}

model NewsArticle {
  id        String   @id @default(cuid())
  query     String
  title     String
  url       String
  snippet   String?
  source    String?
  date      DateTime?
  createdAt DateTime @default(now())

  @@index([query])
  @@index([createdAt])
}

model Setting {
  id        String   @id @default(cuid())
  userId    String
  key       String
  valueEnc  String   // encrypted value
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String?
  ip        String?
  status    String   @default("success") // success | denied | error
  detail    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

model ScreenshotLog {
  id        String   @id @default(cuid())
  userId    String?
  filename  String
  path      String
  size      Int
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model VoiceUsage {
  id        String   @id @default(cuid())
  mode      String   // live | legacy
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  durationMs Int     @default(0)
  createdAt DateTime @default(now())

  @@index([mode])
  @@index([createdAt])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  pinned    Boolean  @default(false)
  color     String   @default("cyan")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([updatedAt])
}
